<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="rootPane" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.gimnasio.controller.MainController"
            style="-fx-background-color: #f5f6fa;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20" />
    </padding>

    <top>
        <VBox spacing="10.0" style="-fx-background-color: #2c3e50; -fx-padding: 20; -fx-background-radius: 10;">
            <Label text="🐶 Sistema Bulldog Key"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;"/>
            <Label text="Comprometidos con la gestión segura de tus datos"
                   style="-fx-font-size: 14px; -fx-text-fill: #bdc3c7;"/>
        </VBox>
    </top>

    <left>
        <VBox spacing="15.0" prefWidth="250.0" style="-fx-padding: 20 10 20 0;">
            <Label text="📋 Menú Principal" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

            <Separator/>

            <Button fx:id="btnRegistroCliente" text="👤 Registrar Cliente"
                    maxWidth="Infinity" onAction="#handleButtonAction"
                    style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8;"/>

            <Button fx:id="btnRegistroEntrenador" text="💪 Registrar Entrenador"
                    maxWidth="Infinity" onAction="#handleButtonAction"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8;"/>

            <Separator/>

            <Button fx:id="btnAccesoHuella" text="🔍 Acceso por Huella"
                    maxWidth="Infinity" onAction="#handleButtonAction"
                    style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8;"/>

            <Separator/>

            <Button fx:id="btnVentas" text="🛒 Ventas"
                    maxWidth="Infinity" onAction="#handleButtonAction"
                    style="-fx-background-color: #e67e22; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8;"/>

            <Button fx:id="btnPagos" text="💰 Pagos en Efectivo"
                    maxWidth="Infinity" onAction="#handleButtonAction"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8;"/>

            <Separator/>

            <Button fx:id="btnCorte" text="📊 Corte de Caja"
                    maxWidth="Infinity" onAction="#handleButtonAction"
                    style="-fx-background-color: #34495e; -fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 12 20; -fx-background-radius: 8;"/>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="mainContent" style="-fx-background-color: white; -fx-border-radius: 10; -fx-background-radius: 10;">
            <!-- Contenido inicial -->
            <VBox spacing="20.0" alignment="CENTER">
                <Label text="🏋️‍♂️" style="-fx-font-size: 60px;"/>
                <Label text="Bienvenido a Bulldog Gym" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Seleccione una opción del menú lateral para comenzar" style="-fx-font-size: 16px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
        </StackPane>
    </center>
</BorderPane>